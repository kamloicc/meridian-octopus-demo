@page
@model IndexModel
@{
    ViewData["Title"] = "Meridian Legacy Loan Processor";
}

<div class="text-center" style="padding: 50px;">
    <div class="card mx-auto" style="max-width: 800px; border: 3px solid #0066cc;">
        <div class="card-header bg-primary text-white">
            <h1 class="display-4 mb-0">🏦 Meridian Legacy Loan Processor</h1>
        </div>
        <div class="card-body text-start">
            <div class="alert alert-info">
                <h4>📊 Deployment Information</h4>
                <hr />
                <div class="row">
                    <div class="col-md-4 fw-bold">Environment:</div>
                    <div class="col-md-8"><code>#{Octopus.Environment.Name}</code></div>
                </div>
                <div class="row mt-2">
                    <div class="col-md-4 fw-bold">Version:</div>
                    <div class="col-md-8"><code>#{Octopus.Release.Number}</code></div>
                </div>
                <div class="row mt-2">
                    <div class="col-md-4 fw-bold">Connection String:</div>
                    <div class="col-md-8"><code>#{LoanProcessor.ConnectionString}</code></div>
                </div>
            </div>
            <div class="mt-4">
                <h5>ℹ️ About This Application</h5>
                <p>This is a legacy ASP.NET Core application demonstrating traditional ZIP-based deployment with Octopus Deploy variable substitution.</p>
                <p class="mb-0"><small class="text-muted">Deployed via Octopus Deploy</small></p>
            </div>
        </div>
    </div>
</div>
